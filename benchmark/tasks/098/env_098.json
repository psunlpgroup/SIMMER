  "action_definitions": {
    "walk": {
      "args": [
        "location"
      ],
      "preconditions": [],
      "effects": [
        "agent_at_location"
      ]
    },
    "open": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_openable",
        "object_closed"
      ],
      "effects": [
        "object_open"
      ]
    },
    "close": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_openable",
        "object_open"
      ],
      "effects": [
        "object_closed"
      ]
    },
    "grab": {
      "args": [
        "object"
      ],
      "preconditions": [
        "agent_hands_empty",
        "object_grabbable"
      ],
      "effects": [
        "agent_holding_object"
      ]
    },
    "cut": {
      "args": [
        "object",
        "cutting_board",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "tool_sharp",
        "object_cuttable",
        "object_on_cutting_board"
      ],
      "effects": [
        "object_cut",
        "object_pieces_created"
      ]
    },
    "crush": {
      "args": [
        "object",
        "tool?"
      ],
      "preconditions": [
        "IF tool THEN agent_holding_tool",
        "IF NOT tool THEN agent_holding_object"
      ],
      "effects": [
        "object_crushed"
      ]
    },
    "break": {
      "args": [
        "object",
        "receptacle"
      ],
      "preconditions": [
        "agent_holding_object",
        "object_breakable"
      ],
      "effects": [
        "object_broken",
        "object_in_receptacle",
        "agent_hands_empty"
      ]
    },
    "pour": {
      "definition": {
        "args": [
          "source",
          "target"
        ],
        "preconditions": [
          "agent_holding_source",
          "source_is_receptacle_or_pourable",
          "target_is_receptacle_or_open_container"
        ],
        "effects": [
          "target_has_source",
          "source_reduced"
        ]
      }
    },
    "stir": {
      "args": [
        "receptacle",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "receptacle_has_contents"
      ],
      "effects": [
        "contents_stirred",
        "contents_mixed"
      ]
    },
    "mix": {
      "args": [
        "receptacle",
        "tool?"
      ],
      "preconditions": [
        "receptacle_has_contents",
        "IF tool THEN agent_holding_tool"
      ],
      "effects": [
        "contents_mixed"
      ]
    },
    "fold": {
      "args": [
        "object",
        "tool?"
      ],
      "preconditions": [
        "object_foldable",
        "IF tool THEN agent_holding_tool",
        "IF NOT tool THEN agent_holding_object"
      ],
      "effects": [
        "object_folded"
      ]
    },
    "press": {
      "args": [
        "object",
        "tool",
        "target?"
      ],
      "preconditions": [
        "agent_holding_tool",
        "IF target THEN target_is_receptacle_or_open_container"
      ],
      "effects": [
        "liquid_extracted",
        "IF target THEN juice_in_target"
      ]
    },
    "unwrap": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_wrapped"
      ],
      "effects": [
        "wrap_removed",
        "object_unwrapped"
      ]
    },
    "wrap": {
      "args": [
        "object",
        "wrap_material"
      ],
      "preconditions": [
        "agent_holding_wrap_material"
      ],
      "effects": [
        "object_wrapped"
      ]
    },
    "fill": {
      "args": [
        "receptacle",
        "source"
      ],
      "preconditions": [
        "source_has_contents_or_source_on"
      ],
      "effects": [
        "receptacle_has_contents"
      ]
    },
    "boil": {
      "args": [
        "object?",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "receptacle_has_liquid",
        "IF object THEN object_in_receptacle"
      ],
      "effects": [
        "contents_boiling",
        "IF object THEN object_cooked",
        "IF object THEN object_hot"
      ]
    },
    "cover": {
      "args": [
        "object",
        "covering"
      ],
      "preconditions": [
        "agent_holding_covering",
        "object_on_surface_or_in_container"
      ],
      "effects": [
        "object_covered",
        "agent_hands_empty"
      ]
    },
    "steam": {
      "args": [
        "object",
        "steamer",
        "pot",
        "heatsource"
      ],
      "preconditions": [
        "object_in_steamer",
        "steamer_in_pot",
        "water_in_pot",
        "pot_on_heatsource",
        "heatsource_on"
      ],
      "effects": [
        "object_cooked",
        "object_steamed",
        "object_hot"
      ]
    },
    "serve": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "object_edible OR object_cooked OR object_is_seasoning OR object_is_condiment",
        "target_is_receptacle_or_surface"
      ],
      "effects": [
        "object_served",
        "object_on_target"
      ]
    },
    "drizzle": {
      "args": [
        "source",
        "target"
      ],
      "preconditions": [
        "agent_holding_source"
      ],
      "effects": [
        "source_applied_to_target",
        "target_coated"
      ]
    },
    "fry": {
      "args": [
        "object",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "receptacle_has_oil",
        "object_in_receptacle"
      ],
      "effects": [
        "object_cooked",
        "object_fried",
        "object_hot"
      ]
    },
    "refrigerate": {
      "args": [
        "object",
        "fridge"
      ],
      "preconditions": [
        "fridge_on",
        "object_in_fridge"
      ],
      "effects": [
        "object_chilled",
        "time_passed"
      ]
    },
    "discard": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object",
        "target_is_trash_bin"
      ],
      "effects": [
        "object_disposed",
        "object_in_target",
        "agent_hands_empty"
      ]
    },
    "heat": {
      "args": [
        "object?",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "IF object THEN object_in_receptacle"
      ],
      "effects": [
        "receptacle_hot",
        "contents_hot",
        "IF object THEN object_hot"
      ]
    },
    "put_on": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object"
      ],
      "effects": [
        "object_on_target",
        "agent_hands_empty"
      ]
    },
    "put_in": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object",
        "target_is_receptacle_or_open_container"
      ],
      "effects": [
        "object_in_target",
        "agent_hands_empty"
      ]
    },
    "rinse": {
      "args": [
        "object",
        "water"
      ],
      "preconditions": [
        "agent_holding_object",
        "water_on"
      ],
      "effects": [
        "object_clean",
        "object_wet"
      ]
    },
    "switch_off": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_is_appliance_or_water",
        "object_on"
      ],
      "effects": [
        "object_off"
      ]
    },
    "switch_on": {
      "args": [
