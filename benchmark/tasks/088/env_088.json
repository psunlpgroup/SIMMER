  "action_definitions": {
    "walk": {
      "args": [
        "location"
      ],
      "preconditions": [],
      "effects": [
        "agent_at_location"
      ]
    },
    "open": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_openable",
        "object_closed"
      ],
      "effects": [
        "object_open"
      ]
    },
    "close": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_openable",
        "object_open"
      ],
      "effects": [
        "object_closed"
      ]
    },
    "grab": {
      "args": [
        "object"
      ],
      "preconditions": [
        "agent_hands_empty",
        "object_grabbable"
      ],
      "effects": [
        "agent_holding_object"
      ]
    },
    "pour": {
      "definition": {
        "args": [
          "source",
          "target"
        ],
        "preconditions": [
          "agent_holding_source",
          "source_is_receptacle_or_pourable",
          "target_is_receptacle_or_open_container"
        ],
        "effects": [
          "target_has_source",
          "source_reduced"
        ]
      }
    },
    "fill": {
      "args": [
        "receptacle",
        "source"
      ],
      "preconditions": [
        "source_has_contents_or_source_on"
      ],
      "effects": [
        "receptacle_has_contents"
      ]
    },
    "wait": {
      "args": [
        "duration"
      ],
      "preconditions": [],
      "effects": [
        "time_passed"
      ]
    },
    "stir": {
      "args": [
        "receptacle",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "receptacle_has_contents"
      ],
      "effects": [
        "contents_stirred",
        "contents_mixed"
      ]
    },
    "boil": {
      "args": [
        "object?",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "receptacle_has_liquid",
        "IF object THEN object_in_receptacle"
      ],
      "effects": [
        "contents_boiling",
        "IF object THEN object_cooked",
        "IF object THEN object_hot"
      ]
    },
    "drain": {
      "args": [
        "object",
        "receptacle"
      ],
      "preconditions": [
        "object_in_receptacle",
        "receptacle_has_liquid"
      ],
      "effects": [
        "liquid_removed",
        "object_drained"
      ]
    },
    "chop": {
      "args": [
        "object",
        "cutting_board",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "tool_sharp",
        "object_on_cutting_board",
        "object_cuttable"
      ],
      "effects": [
        "object_chopped",
        "object_chunks_created"
      ]
    },
    "fry": {
      "args": [
        "object",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "receptacle_has_oil",
        "object_in_receptacle"
      ],
      "effects": [
        "object_cooked",
        "object_fried",
        "object_hot"
      ]
    },
    "transfer": {
      "args": [
        "object",
        "target",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "target_is_receptacle_or_surface"
      ],
      "effects": [
        "object_at_target"
      ]
    },
    "simmer": {
      "args": [
        "object?",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "receptacle_has_liquid",
        "IF object THEN object_in_receptacle"
      ],
      "effects": [
        "IF object THEN object_cooked",
        "IF object THEN object_hot",
        "liquid_hot",
        "contents_simmering"
      ]
    },
    "mix": {
      "args": [
        "receptacle",
        "tool?"
      ],
      "preconditions": [
        "receptacle_has_contents",
        "IF tool THEN agent_holding_tool"
      ],
      "effects": [
        "contents_mixed"
      ]
    },
    "spread": {
      "args": [
        "object",
        "target",
        "tool"
      ],
      "preconditions": [
        "object_spreadable",
        "agent_holding_tool"
      ],
      "effects": [
        "object_applied_to_target"
      ]
    },
    "cover": {
      "args": [
        "object",
        "covering"
      ],
      "preconditions": [
        "agent_holding_covering",
        "object_on_surface_or_in_container"
      ],
      "effects": [
        "object_covered",
        "agent_hands_empty"
      ]
    },
    "bake": {
      "args": [
        "object",
        "receptacle",
        "appliance",
        "duration"
      ],
      "preconditions": [
        "appliance_on",
        "object_in_receptacle",
        "receptacle_in_appliance"
      ],
      "effects": [
        "object_cooked",
        "object_baked",
        "object_hot"
      ]
    },
    "rest": {
      "args": [
        "object",
        "duration"
      ],
      "preconditions": [
        "object_cooked"
      ],
      "effects": [
        "object_rested",
        "object_cooked"
      ]
    },
    "refrigerate": {
      "args": [
        "object",
        "fridge"
      ],
      "preconditions": [
        "fridge_on",
        "object_in_fridge"
      ],
      "effects": [
        "object_chilled",
        "time_passed"
      ]
    },
    "break": {
      "args": [
        "object",
        "receptacle"
      ],
      "preconditions": [
        "agent_holding_object",
        "object_breakable"
      ],
      "effects": [
        "object_broken",
        "object_in_receptacle",
        "agent_hands_empty"
      ]
    },
    "discard": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object",
        "target_is_trash_bin"
      ],
      "effects": [
        "object_disposed",
        "object_in_target",
        "agent_hands_empty"
      ]
    },
    "heat": {
      "args": [
        "object?",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "IF object THEN object_in_receptacle"
      ],
      "effects": [
        "receptacle_hot",
        "contents_hot",
        "IF object THEN object_hot"
      ]
    },
    "put_on": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object"
      ],
      "effects": [
        "object_on_target",
        "agent_hands_empty"
      ]
    },
    "put_in": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object",
        "target_is_receptacle_or_open_container"
      ],
      "effects": [
        "object_in_target",
        "agent_hands_empty"
      ]
    },
    "serve": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "object_edible OR object_cooked OR object_is_seasoning OR object_is_condiment",
        "target_is_receptacle_or_surface"
      ],
      "effects": [
        "object_served",
        "object_on_target"
      ]
    },
    "rinse": {
      "args": [
        "object",
        "water"
      ],
      "preconditions": [
        "agent_holding_object",
        "water_on"
      ],
      "effects": [
        "object_clean",
        "object_wet"
      ]
    },
    "switch_off": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_is_appliance_or_water",
        "object_on"
      ],
      "effects": [
        "object_off"
      ]
    },
    "switch_on": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_is_appliance_or_water",
        "object_off"
      ],
      "effects": [
        "object_on"
      ]
    },
    "take_out": {
      "args": [
        "object",
        "container",
        "tool?"
      ],
      "preconditions": [
        "object_in_container",
        "container_open",
        "IF tool THEN agent_holding_tool",
        "IF NOT tool THEN agent_holding_object"
      ],
      "effects": [
        "object_removed_from_container",
        "agent_holding_object"
      ]
    },
    "wash": {
      "args": [
        "object",
        "water"
      ],
      "preconditions": [
        "object_dirty",
        "agent_holding_object",
        "water_on"
      ],
      "effects": [
        "object_clean",
        "object_wet"
      ]
    },
    "combine": {
      "args": [
        "container",
        "product_name"
      ],
      "preconditions": [
        "container_has_contents"
      ],
      "effects": [
        "product_created_in_container"
      ]
    }
  },
  "agent": {
