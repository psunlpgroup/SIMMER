  "action_definitions": {
    "walk": {
      "args": [
        "location"
      ],
      "preconditions": [],
      "effects": [
        "agent_at_location"
      ]
    },
    "open": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_openable",
        "object_closed"
      ],
      "effects": [
        "object_open"
      ]
    },
    "close": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_openable",
        "object_open"
      ],
      "effects": [
        "object_closed"
      ]
    },
    "grab": {
      "args": [
        "object"
      ],
      "preconditions": [
        "agent_hands_empty",
        "object_grabbable"
      ],
      "effects": [
        "agent_holding_object"
      ]
    },
    "drizzle": {
      "args": [
        "source",
        "target"
      ],
      "preconditions": [
        "agent_holding_source"
      ],
      "effects": [
        "source_applied_to_target",
        "target_coated"
      ]
    },
    "wrap": {
      "args": [
        "object",
        "wrap_material"
      ],
      "preconditions": [
        "agent_holding_wrap_material"
      ],
      "effects": [
        "object_wrapped"
      ]
    },
    "set_temp": {
      "args": [
        "appliance",
        "temperature"
      ],
      "preconditions": [
        "appliance_on"
      ],
      "effects": [
        "appliance_set_to_temperature"
      ]
    },
    "set_timer": {
      "args": [
        "appliance",
        "duration"
      ],
      "preconditions": [
        "appliance_on"
      ],
      "effects": [
        "timer_running"
      ]
    },
    "wait": {
      "args": [
        "duration"
      ],
      "preconditions": [],
      "effects": [
        "time_passed"
      ]
    },
    "bake": {
      "args": [
        "object",
        "receptacle",
        "appliance",
        "duration"
      ],
      "preconditions": [
        "appliance_on",
        "object_in_receptacle",
        "receptacle_in_appliance"
      ],
      "effects": [
        "object_cooked",
        "object_baked",
        "object_hot"
      ]
    },
    "cool": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_hot"
      ],
      "effects": [
        "object_cooled_to_room_temp",
        "time_passed"
      ]
    },
    "cut": {
      "args": [
        "object",
        "cutting_board",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "tool_sharp",
        "object_cuttable",
        "object_on_cutting_board"
      ],
      "effects": [
        "object_cut",
        "object_pieces_created"
      ]
    },
    "squeeze": {
      "args": [
        "source",
        "target"
      ],
      "preconditions": [
        "agent_holding_source",
        "source_has_contents",
        "target_is_receptacle_or_open_container"
      ],
      "effects": [
        "contents_squeezed",
        "contents_in_target"
      ]
    },
    "refrigerate": {
      "args": [
        "object",
        "fridge"
      ],
      "preconditions": [
        "fridge_on",
        "object_in_fridge"
      ],
      "effects": [
        "object_chilled",
        "time_passed"
      ]
    },
    "discard": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object",
        "target_is_trash_bin"
      ],
      "effects": [
        "object_disposed",
        "object_in_target",
        "agent_hands_empty"
      ]
    },
    "heat": {
      "args": [
        "object?",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "IF object THEN object_in_receptacle"
      ],
      "effects": [
        "receptacle_hot",
        "contents_hot",
        "IF object THEN object_hot"
      ]
    },
    "pour": {
      "definition": {
        "args": [
          "source",
          "target"
        ],
        "preconditions": [
          "agent_holding_source",
          "source_is_receptacle_or_pourable",
          "target_is_receptacle_or_open_container"
        ],
        "effects": [
          "target_has_source",
          "source_reduced"
        ]
      }
    },
    "put_on": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object"
      ],
      "effects": [
        "object_on_target",
        "agent_hands_empty"
      ]
    },
    "put_in": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object",
        "target_is_receptacle_or_open_container"
      ],
      "effects": [
        "object_in_target",
        "agent_hands_empty"
      ]
    },
    "serve": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "object_edible OR object_cooked OR object_is_seasoning OR object_is_condiment",
        "target_is_receptacle_or_surface"
      ],
      "effects": [
        "object_served",
        "object_on_target"
      ]
    },
    "rinse": {
      "args": [
        "object",
        "water"
      ],
      "preconditions": [
        "agent_holding_object",
        "water_on"
      ],
      "effects": [
        "object_clean",
        "object_wet"
      ]
    },
    "switch_off": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_is_appliance_or_water",
        "object_on"
      ],
      "effects": [
        "object_off"
      ]
    },
    "switch_on": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_is_appliance_or_water",
        "object_off"
      ],
      "effects": [
        "object_on"
      ]
    },
    "take_out": {
      "args": [
        "object",
        "container",
        "tool?"
      ],
      "preconditions": [
        "object_in_container",
        "container_open",
        "IF tool THEN agent_holding_tool",
        "IF NOT tool THEN agent_holding_object"
      ],
      "effects": [
        "object_removed_from_container",
        "agent_holding_object"
      ]
    },
    "transfer": {
      "args": [
        "object",
        "target",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "target_is_receptacle_or_surface"
      ],
      "effects": [
        "object_at_target"
      ]
    },
    "wash": {
      "args": [
        "object",
        "water"
      ],
      "preconditions": [
        "object_dirty",
        "agent_holding_object",
        "water_on"
      ],
      "effects": [
        "object_clean",
        "object_wet"
      ]
    },
    "combine": {
      "args": [
        "container",
        "product_name"
      ],
      "preconditions": [
        "container_has_contents"
      ],
      "effects": [
        "product_created_in_container"
      ]
    }
  },
  "agent": {
    "id": 1,
    "location": "kitchen",
    "holding": null,
    "states": [
      "hands_empty"
    ]
  }
