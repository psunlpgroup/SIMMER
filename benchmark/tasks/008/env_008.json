  "action_definitions": {
    "walk": {
      "args": [
        "location"
      ],
      "preconditions": [],
      "effects": [
        "agent_at_location"
      ]
    },
    "open": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_openable",
        "object_closed"
      ],
      "effects": [
        "object_open"
      ]
    },
    "close": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_openable",
        "object_open"
      ],
      "effects": [
        "object_closed"
      ]
    },
    "grab": {
      "args": [
        "object"
      ],
      "preconditions": [
        "agent_hands_empty",
        "object_grabbable"
      ],
      "effects": [
        "agent_holding_object"
      ]
    },
    "pour": {
      "definition": {
        "args": [
          "source",
          "target"
        ],
        "preconditions": [
          "agent_holding_source",
          "source_is_receptacle_or_pourable",
          "target_is_receptacle_or_open_container"
        ],
        "effects": [
          "target_has_source",
          "source_reduced"
        ]
      }
    },
    "shake": {
      "args": [
        "container"
      ],
      "preconditions": [
        "container_closed",
        "container_has_contents",
        "agent_holding_container"
      ],
      "effects": [
        "contents_mixed"
      ]
    },
    "blend": {
      "args": [
        "appliance",
        "object"
      ],
      "preconditions": [
        "appliance_on",
        "object_in_appliance"
      ],
      "effects": [
        "object_blended"
      ]
    },
    "freeze": {
      "args": [
        "object",
        "freezer"
      ],
      "preconditions": [
        "freezer_on",
        "object_in_freezer"
      ],
      "effects": [
        "object_frozen",
        "time_passed"
      ]
    },
    "cover": {
      "args": [
        "object",
        "covering"
      ],
      "preconditions": [
        "agent_holding_covering",
        "object_on_surface_or_in_container"
      ],
      "effects": [
        "object_covered",
        "agent_hands_empty"
      ]
    },
    "wait": {
      "args": [
        "duration"
      ],
      "preconditions": [],
      "effects": [
        "time_passed"
      ]
    },
    "stir": {
      "args": [
        "receptacle",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "receptacle_has_contents"
      ],
      "effects": [
        "contents_stirred",
        "contents_mixed"
      ]
    },
    "mix": {
      "args": [
        "receptacle",
        "tool?"
      ],
      "preconditions": [
        "receptacle_has_contents",
        "IF tool THEN agent_holding_tool"
      ],
      "effects": [
        "contents_mixed"
      ]
    },
    "transfer": {
      "args": [
        "object",
        "target",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "target_is_receptacle_or_surface"
      ],
      "effects": [
        "object_at_target"
      ]
    },
    "refrigerate": {
      "args": [
        "object",
        "fridge"
      ],
      "preconditions": [
        "fridge_on",
        "object_in_fridge"
      ],
      "effects": [
        "object_chilled",
        "time_passed"
      ]
    },
    "whisk": {
      "args": [
        "receptacle",
        "tool"
      ],
      "preconditions": [
        "agent_holding_tool",
        "receptacle_has_contents"
      ],
      "effects": [
        "contents_whisked",
        "mixture_smoother"
      ]
    },
    "discard": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object",
        "target_is_trash_bin"
      ],
      "effects": [
        "object_disposed",
        "object_in_target",
        "agent_hands_empty"
      ]
    },
    "heat": {
      "args": [
        "object?",
        "receptacle",
        "heatsource"
      ],
      "preconditions": [
        "receptacle_on_heatsource",
        "heatsource_on",
        "IF object THEN object_in_receptacle"
      ],
      "effects": [
        "receptacle_hot",
        "contents_hot",
        "IF object THEN object_hot"
      ]
    },
    "put_on": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object"
      ],
      "effects": [
        "object_on_target",
        "agent_hands_empty"
      ]
    },
    "put_in": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "agent_holding_object",
        "target_is_receptacle_or_open_container"
      ],
      "effects": [
        "object_in_target",
        "agent_hands_empty"
      ]
    },
    "serve": {
      "args": [
        "object",
        "target"
      ],
      "preconditions": [
        "object_edible OR object_cooked OR object_is_seasoning OR object_is_condiment",
        "target_is_receptacle_or_surface"
      ],
      "effects": [
        "object_served",
        "object_on_target"
      ]
    },
    "rinse": {
      "args": [
        "object",
        "water"
      ],
      "preconditions": [
        "agent_holding_object",
        "water_on"
      ],
      "effects": [
        "object_clean",
        "object_wet"
      ]
    },
    "switch_off": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_is_appliance_or_water",
        "object_on"
      ],
      "effects": [
        "object_off"
      ]
    },
    "switch_on": {
      "args": [
        "object"
      ],
      "preconditions": [
        "object_is_appliance_or_water",
        "object_off"
      ],
      "effects": [
        "object_on"
      ]
    },
    "take_out": {
      "args": [
        "object",
        "container",
        "tool?"
      ],
      "preconditions": [
        "object_in_container",
        "container_open",
        "IF tool THEN agent_holding_tool",
        "IF NOT tool THEN agent_holding_object"
      ],
      "effects": [
        "object_removed_from_container",
        "agent_holding_object"
      ]
    },
    "wash": {
      "args": [
        "object",
        "water"
      ],
      "preconditions": [
        "object_dirty",
        "agent_holding_object",
        "water_on"
      ],
      "effects": [
        "object_clean",
        "object_wet"
      ]
    },
    "combine": {
      "args": [
        "container",
        "product_name"
      ],
      "preconditions": [
        "container_has_contents"
      ],
      "effects": [
        "product_created_in_container"
      ]
    }
  },
  "agent": {
    "id": 1,
    "location": "kitchen",
    "holding": null,
    "states": [
      "hands_empty"
    ]
  }
}